# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (local) or configure in your host's secret manager (production).
# NEVER commit real values. Nothing here uses the NEXT_PUBLIC_ prefix: every
# value is server-only.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | staging | production
APP_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Roamwell
SUPPORT_EMAIL=support@example.com

# PostgreSQL (docker compose up -d starts one on port 55433)
DATABASE_URL=postgresql://esim:esim_dev_password@localhost:55433/esim?schema=public
DATABASE_POOL_MAX=10
# Hosted databases with a private CA (Supabase): paste the CA certificate's PEM contents
# here so the server certificate is verified. See docs/DEPLOYMENT.md, "Supabase".
DATABASE_SSL_CA=

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 32-byte key for encrypting activation codes and SMS at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Key rotation only: retired keys (comma-separated) still accepted for decryption until
# `pnpm data:reencrypt` reports nothing left. See docs/SECURITY.md. Normally empty.
DATA_ENCRYPTION_KEYS_PREVIOUS=

# Optional Google sign-in (only enabled when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supplier: 1001SMS (eSIMs, SMS activations, number rentals) ──
# live | sandbox | disabled. sandbox is forbidden when APP_ENV=production.
SUPPLIER_MODE=sandbox
SMS1001_BASE_URL=https://www.1001sms.com/api/v1
# API key needs scopes: read, activate, numbers, esim
SMS1001_API_KEY=
# Signing secret returned by PUT /webhooks/config (shown once)
SMS1001_WEBHOOK_SECRET=
# 1001SMS does not document its price currency — confirm before going live.
SUPPLIER_PRICE_CURRENCY=USD
SUPPLIER_TIMEOUT_MS=20000

# ── Payments ──
# paystack | sandbox | disabled. sandbox must be paired with SUPPLIER_MODE=sandbox.
PAYMENT_PROVIDER=sandbox
# Settlement/checkout currency enabled on your gateway account (e.g. GHS, USD)
PAYMENT_CURRENCY=USD
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Signs simulated payment and supplier webhooks in sandbox mode only
SANDBOX_SIGNING_SECRET=

# ── Email ──
# resend | log. log stores emails in the database for local testing only.
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Roamwell <no-reply@example.com>

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
